# Every variable the application reads (US-004). Safe LOCAL defaults only — never real secrets.
# Copy to .env to override. Production values come from AWS Secrets Manager / ECS task definitions.

# --- Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-dev-secret-key-change-me-not-used-anywhere-but-your-laptop
# Comma-separated previous keys, so SECRET_KEY can rotate without logging everyone out
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8080
ADMIN_URL_PREFIX=ops/admin/
APP_ENV=local
APP_RELEASE=local

# --- Data stores (docker compose service names)
DATABASE_URL=postgis://rpl:rpl@db:5432/rpl
# Optional read replica (search reads); empty = use default
DATABASE_REPLICA_URL=
# PaaS add-ons usually give one REDIS_URL (used for both when the two below are empty).
REDIS_URL=
CACHE_URL=redis://valkey:6379/0
CELERY_BROKER_URL=redis://valkey:6379/1
# "require" for managed databases reached over a network
DATABASE_SSLMODE=

# --- Email (Mailpit locally: http://localhost:8025)
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=Rent Property Listing <no-reply@localhost>

# --- Logging & observability
LOG_LEVEL=INFO
LOG_JSON=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
OTEL_ENABLED=false
# Standard OpenTelemetry variables (read by the SDK when OTEL_ENABLED=true)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Proxies & client IP (production: see docs/architecture/05 §5)
# Hops appending to X-Forwarded-For (PaaS router / Caddy / kamal-proxy / Traefik = 1)
TRUSTED_PROXY_COUNT=0
# Or a trusted edge header: CF-Connecting-IP (Cloudflare), Fly-Client-IP (Fly.io)
CLIENT_IP_HEADER=
# Gunicorn: trust X-Forwarded-Proto from these addresses ("*" in production behind the proxy)
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Processes (bin/web, bin/worker, bin/beat, bin/release)
# PORT is injected by PaaS platforms; 8000 otherwise
PORT=8000
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=2
CELERY_QUEUES=default,maintenance,media
# Run migrations at web start (Kamal/Coolify, which have no release phase)
RELEASE_ON_START=false
