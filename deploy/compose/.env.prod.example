# Production variables for deploy/compose/compose.prod.yaml. Copy to .env.prod (git-ignored).
SITE_ADDRESS=www.example.com
POSTGRES_PASSWORD=change-me-long-random

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-at-least-50-random-characters-generated-with-a-secret-generator
DJANGO_ALLOWED_HOSTS=www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com
APP_ENV=prod

DATABASE_URL=postgis://rpl:change-me-long-random@db:5432/rpl
REDIS_URL=redis://valkey:6379/0

EMAIL_URL=smtp+tls://user:password@smtp.example-provider.com:587
DEFAULT_FROM_EMAIL=Rent Property Listing <no-reply@example.com>

# Behind Caddy (1 hop). Behind Cloudflare too: CLIENT_IP_HEADER=CF-Connecting-IP instead.
TRUSTED_PROXY_COUNT=1
FORWARDED_ALLOW_IPS=*

LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
WEB_CONCURRENCY=3
WORKER_CONCURRENCY=2
